{
  "name": "dsh-jujutsu",
  "version": "0.1.0",
  "description": "Jujutsu-native version control for the DeepSeek Harness: a guard that refuses Git inside a jj workspace, and a jj-hunk bridge for non-interactive hunk selection.",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "jujutsu",
    "jj",
    "jj-hunk"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vp pack && node scripts/name-client-bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "tsc --noEmit && pnpm run build && vitest run",
    "prepublishOnly": "pnpm run build && pnpm run ci",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vite-plus": "1.1.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || >=4.0.5-0 <4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "node": ">=24",
      "dsh": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztor/dsh-jujutsu.git"
  },
  "icon": "./icon.svg"
}
