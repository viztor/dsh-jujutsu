{
  "name": "dsh-jujutsu",
  "version": "0.3.0",
  "description": "Refuses Git inside a Jujutsu workspace and hands the model the jj command instead. Eleven jj tools, prompt teaching, and a jj-hunk bridge for the DeepSeek Harness.",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "git",
    "git-replacement",
    "jj",
    "jj-hunk",
    "jujutsu",
    "vcs",
    "version-control"
  ],
  "homepage": "https://github.com/viztor/dsh-jujutsu#readme",
  "bugs": {
    "url": "https://github.com/viztor/dsh-jujutsu/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztor/dsh-jujutsu.git"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vp pack && node scripts/name-client-bundle.ts",
    "check": "vp check",
    "package-check": "node scripts/check.ts",
    "ci": "vp run gate",
    "lint": "vp lint",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "vp run ci",
    "prepare": "vp run build",
    "gate": "vp check && vp run build && vp test run && vp run package-check",
    "version:patch": "vp pm version patch --no-git-checks",
    "version:minor": "vp pm version minor --no-git-checks",
    "version:major": "vp pm version major --no-git-checks"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || >=4.0.5-0 <4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "node": ">=24",
      "dsh": "^0.2.0-rc.1 || >=0.2.1-0 <0.3.0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
